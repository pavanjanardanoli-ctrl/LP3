//DAA 1 Fibonacii Series

import java.util.*;
public class Fibonaciirecursive_And_NonRecursive {
     public static int fiborecur(int n){
        if (n <= 1) {
            return n;
        }
        return fiborecur(n - 1) + fiborecur(n - 2);
    }

    public static void fibononrecursive(int n){
        int num1=0;int num2=1;
        for(int i=0;i<n;i++){
            System.out.print(num1 +" ");

            //Swap
            int num3=num1+num2;
            num1=num2;
            num2=num3;
        }
    }

public static void main(String[] args){
    int n=10;
    System.out.println("fibonacci Series is "+ fiborecur(n));
    System.out.print("fibonacii series is : ");
    fibononrecursive(n);
    System.out.println();
}
}
